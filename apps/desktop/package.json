{
  "name": "@savedata-sync/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "vite build && pnpm build:sidecar",
    "build:sidecar": "vite build -c vite.sidecar.config.ts",
    "package": "node scripts/package-windows.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@homebridge/ciao": "1.3.12",
    "@savedata-sync/shared": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "antd": "6.6.7",
    "bonjour-service": "1.4.4",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.26.0",
    "resedit": "^3.1.0"
  }
}
