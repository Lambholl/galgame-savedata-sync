{
  "name": "@savedata-sync/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "package:win": "pnpm build && node scripts/package-windows.mjs",
    "package:win:portable": "pnpm build && node scripts/package-windows.mjs portable",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@savedata-sync/shared": "workspace:*",
    "antd": "6.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0"
  }
}
