##############################################################################
#
#   Gradle 生成的 POSIX 启动脚本。
#
#   运行须知：
#
#   (1) 此脚本需要兼容 POSIX 的 shell。如果 /bin/sh 不兼容，
#       但系统上有 ksh 或 bash 等兼容的 shell，
#       请在完整命令前加上该 shell 的名称，
#       例如：
#
#           ksh Gradle
#
#       Busybox 等精简 shell 无法运行此脚本，因为脚本
#       需要以下全部 POSIX shell 特性：
#         * 函数；
#         * 变量展开 «$var», «${var}», «${var:-default}», «${var+SET}»,
#           «${var#prefix}»、«${var%suffix}» 以及 «$( cmd )»；
#         * 可检查退出状态的复合命令，尤其是 «case»；
#         * «command»、«set» 和 «ulimit» 等内建命令。
#
#   修改须知：
#
#   (2) 此脚本面向所有 POSIX shell，因此避免使用 Bash、Ksh 等的扩展，
#       尤其不使用数组。
#
#       将多个参数拼成空格分隔字符串的传统做法
#       容易引发已知的错误和安全问题，
#       因此脚本尽量把选项逐步累积到 "$@" 中，
#       最后一起传给 Java。
#
#       对继承的环境变量 DEFAULT_JVM_OPTS、JAVA_OPTS 和 GRADLE_OPTS，
#       若需要按单词拆分，则显式进行处理；
#       详情见对应的行内注释。
#
#       脚本包含针对 AIX、CygWin、Darwin、MinGW 和 NonStop
#       等操作系统的适配。
#
#   (3) 此脚本由 Gradle 项目中的以下 Groovy 模板生成：
#       https://github.com/gradle/gradle/blob/HEAD/platforms/jvm/plugins-application/src/main/resources/org/gradle/api/internal/plugins/unixStartScript.txt
#
#       Gradle 项目地址：https://github.com/gradle/gradle/。
#
##############################################################################

# 尝试设置 APP_HOME

# 解析链接：$0 可能是链接
app_path=$0

# 此循环用于处理多层符号链接。
while
    APP_HOME=${app_path%"${app_path##*/}"}  # 保留末尾的 /；没有路径前缀时为空
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# 此变量通常未使用
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
# 丢弃 cd 的标准输出，以兼容设置了 $CDPATH 的情况（https://github.com/gradle/gradle/issues/25036）
APP_HOME=$( cd -P "${APP_HOME:-./}" > /dev/null && printf '%s\n' "$PWD" ) || exit

# 使用可用的最大值；也可将 MAX_FD 设为非 -1 的值以指定上限。
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# 操作系统适配开关（必须为 'true' 或 'false'）。
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH="\\\"\\\""


# 确定用于启动 JVM 的 Java 命令。
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # AIX 上 IBM JDK 的可执行文件位于特殊目录
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# 在系统允许时提高文件描述符上限。
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # POSIX sh 未定义 ulimit -H，因此需要检查执行结果以确认是否受支持。
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # POSIX sh 未定义 ulimit -n，因此需要检查执行结果以确认是否受支持。
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# 按逆序收集 Java 命令的全部参数：
#   * 命令行参数
#   * 主类名称
#   * -classpath 类路径
#   * -D...appname 设置
#   * --module-path 模块路径（仅在需要时）
#   * DEFAULT_JVM_OPTS、JAVA_OPTS 和 GRADLE_OPTS 环境变量。

# 在 Cygwin 或 MSYS 中，运行 Java 前先将路径转换为 Windows 格式
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # 转换参数；采用此变通方式以保持 /bin/sh 兼容性
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # 不修改选项 #(
              /?*)  t=${arg#/} t=/${t%%/*}              # 可能是 POSIX 文件路径
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" )
        fi
        # 按参数总数轮转参数列表，
        # 使每个参数最终回到原来的位置，
        # 但其内容可能已被转换。
        #
        # 注意：`for` 循环在开始前就确定了迭代列表，
        # 因此在这里修改位置参数不会影响迭代次数，
        # 也不会影响 `arg` 取得的值。
        shift                   # 移除旧参数
        set -- "$@" "$arg"      # 追加替换后的参数
    done
fi


# 在此添加默认 JVM 选项；也可通过 JAVA_OPTS 和 GRADLE_OPTS 向此脚本传入 JVM 选项。
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# 收集 Java 命令的全部参数：
#   * DEFAULT_JVM_OPTS、JAVA_OPTS 和 optsEnvironmentVar 不允许包含 shell 代码片段，
#     其中的 shell 特殊字符均会被转义。
#   * 例如：不要期望 ${Hostname} 被展开；环境变量中的这段文本
#     会在命令行上作为字面量 '${Hostname}' 处理。

set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        -jar "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
        "$@"

# "xargs" 不可用时停止执行。
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# 使用 "xargs" 解析带引号的参数。
#
# -n1 使其每行输出一个参数，并移除引号和反斜杠。
#
# 在 Bash 中可以直接这样写：
#
#   readarray ARGS < <( xargs -n1 <<<"$var" ) &&
#   set -- "${ARGS[@]}" "$@"
#
# 但 POSIX shell 不支持上述数组和进程替换写法，因此这里
# 将每个参数作为 sed 的一行输入进行后处理，
# 用反斜杠转义可能的 shell 元字符，再通过 eval 还原，
# 同时保留各参数的边界，
# 最后将整个过程组合为一条 "set" 语句。
#
# 如果任一变量包含换行符或未配对的引号，
# 此处理方式就会失效。
#

eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-[:alnum:]+,./:=@_]~\\&~g; ' |
        tr '\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"
