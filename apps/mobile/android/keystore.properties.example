# 复制为同目录的 keystore.properties 后填写；keystore.properties 已被 Git 忽略。
# 配置后 debug 与 release 包都用这把密钥签名，生成方式见 docs/development.md 的“Android 签名”。
# 路径用正斜杠，反斜杠在 properties 文件里是转义符。

# 密钥库文件，放在仓库外
storeFile=C:/path/to/savedata-sync-release.jks

# keytool 提示 Enter keystore password 时输入的密码
storePassword=

# keytool 命令里 -alias 的值
keyAlias=savedata-sync

# PKCS12 密钥库与 storePassword 相同
keyPassword=
