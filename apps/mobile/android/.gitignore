# 采用 Android 忽略模板： https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# 构建后的应用文件
*.apk
*.aar
*.ap_
*.aab

# ART/Dalvik 虚拟机文件
*.dex

# Java 类文件
*.class

# 生成文件
bin/
gen/
out/
#  如需忽略应用中的 release 构建类型文件，请取消下一行的注释
# release/

# Gradle 文件
.gradle/
build/

# 本地配置文件（SDK 路径等）
local.properties

# Eclipse 生成的 ProGuard 目录
proguard/

# 日志文件
*.log

# Android Studio 导航编辑器临时文件
.navigation/

# Android Studio 捕获文件目录
captures/

# IntelliJ 工程文件
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 的忽略项。
.idea/caches
.idea/modules.xml
# 如需保留导航编辑器中的元素位置，请注释下一行
.idea/navEditor.xml

# 密钥库文件
# 如需避免将密钥库文件提交到版本库，请取消以下行的注释。
#*.jks
#*.keystore

# Android Studio 2.2 及更高版本生成的外部原生构建目录
.externalNativeBuild
.cxx/

# Google 服务配置（如 API 或 Firebase）
# google-services.json

# Freeline 构建文件
freeline.py
freeline/
freeline_project_description.json

# fastlane 构建文件
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# 版本控制文件
vcs.xml

# lint 检查产物
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android 性能分析文件
*.hprof

# Capacitor 的 Cordova 插件
capacitor-cordova-android-plugins

# 复制后的 Web 资源
app/src/main/assets/public

# 生成的配置文件
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
